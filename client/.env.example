# Base URL of the API.
# Local dev: keep /api (the Vite dev proxy forwards it to the server).
# Production (Vercel): full backend URL, e.g. https://bugboard-api.onrender.com/api
VITE_API_URL=/api
# Where the dev proxy forwards /api and /uploads (local dev only)
VITE_PROXY_TARGET=http://localhost:5000
